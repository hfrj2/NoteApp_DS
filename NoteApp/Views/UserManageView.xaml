<UserControl
    x:Class="NoteApp.Views.UserManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!--  左侧用户列表  -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="0,0,10,0"
                    Background="ForestGreen"
                    Command="{Binding AddCommand}"
                    Content="新增"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White" 
                     Style="{StaticResource RoundedButtonStyle}"/>
                <Button
                    Width="80"
                    Background="#3498DB"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White" 
                     Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Users}"
                SelectedItem="{Binding SelectedUser}"
                SelectionMode="Single"
                Style="{StaticResource BlueGrayDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Id}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding AccountName}"
                        Header="账户名" />
                    <DataGridTextColumn
                        Width="120"
                        Binding="{Binding Phone}"
                        Header="电话" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Address}"
                        Header="地址" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--  右侧编辑区  -->
        <Border
            Grid.Column="1"
            Padding="15"
            BorderBrush="#DDD"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="用户编辑" />
                <TextBlock Margin="0,0,0,5" Text="账户名" />
                <TextBox
                    Height="30"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding EditAccountName, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,5" Text="密码（编辑时留空表示不修改）" />
                <PasswordBox
                    x:Name="PasswordBox"
                    Height="30"
                    Padding="5" />
                <TextBlock Margin="0,10,0,5" Text="电话" />
                <TextBox
                    Height="30"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,5" Text="地址" />
                <TextBox
                    Height="30"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" />
                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,10,0"
                        Background="ForestGreen"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" 
                         Style="{StaticResource RoundedButtonStyle}"/>
                    <Button
                        Width="80"
                        Background="Red"
                        Command="{Binding DeleteCommand}"
                        Content="删除"
                        FontSize="14"
                        FontWeight="SemiBold" 
                         Style="{StaticResource RoundedButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>