<UserControl x:Class="NoteApp.Views.UserManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧用户列表 -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="新增" Width="80" Margin="0,0,10,0" Command="{Binding AddCommand}"/>
                <Button Content="刷新" Width="80" Command="{Binding RefreshCommand}"/>
            </StackPanel>
            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="账户名" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="电话" Binding="{Binding Phone}" Width="120"/>
                    <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- 右侧编辑区 -->
        <Border Grid.Column="1" BorderBrush="#DDD" BorderThickness="1" Padding="15">
            <StackPanel>
                <TextBlock Text="用户编辑" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                <TextBlock Text="账户名" Margin="0,0,0,5"/>
                <TextBox Text="{Binding EditAccountName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                <TextBlock Text="密码（编辑时留空表示不修改）" Margin="0,10,0,5"/>
                <PasswordBox x:Name="PasswordBox" Height="30" Padding="5"/>
                <TextBlock Text="电话" Margin="0,10,0,5"/>
                <TextBox Text="{Binding EditPhone, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                <TextBlock Text="地址" Margin="0,10,0,5"/>
                <TextBox Text="{Binding EditAddress, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" VerticalContentAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="保存" Width="80" Margin="0,0,10,0" Command="{Binding SaveCommand}"/>
                    <Button Content="删除" Width="80" Command="{Binding DeleteCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>