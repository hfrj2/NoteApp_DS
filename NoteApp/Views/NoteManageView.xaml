<UserControl
    x:Class="NoteApp.Views.NoteManageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!--  左侧便签列表  -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                <Button
                    Width="80"
                    Margin="5,0"
                    Padding="20,10"
                    Background="#27AE60"
                    Command="{Binding AddCommand}"
                    Content="新增"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White" 
                    Style="{StaticResource RoundedButtonStyle}"/>
                <Button
                    Width="80"
                    Margin="5,0"
                    Padding="20,10"
                    Background="#3498DB"
                    Command="{Binding RefreshCommand}"
                    Content="刷新"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White" 
                     Style="{StaticResource RoundedButtonStyle}"/>
            </StackPanel>
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Notes}"
                SelectedItem="{Binding SelectedNote}"
                SelectionMode="Single"
                Style="{StaticResource BlueGrayDataGridStyle}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="50"
                        Binding="{Binding Id}"
                        Header="ID" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Title}"
                        Header="标题" />
                    <DataGridTextColumn
                        Width="150"
                        Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}"
                        Header="创建时间" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!--  右侧编辑区  -->
        <Border
            Grid.Column="1"
            Padding="15"
            BorderBrush="#DDD"
            BorderThickness="1">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,20"
                    FontSize="18"
                    FontWeight="Bold"
                    Text="便签编辑" />
                <TextBlock Margin="0,0,0,5" Text="标题" />
                <TextBox
                    Height="30"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,10,0,5" Text="内容" />
                <TextBox
                    Height="200"
                    Padding="5"
                    AcceptsReturn="True"
                    Text="{Binding EditContent, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Auto" />
                <TextBlock Margin="0,10,0,5" Text="创建时间" />
                <TextBox
                    Height="30"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    IsReadOnly="True"
                    Text="{Binding EditCreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="5,0"
                        Padding="20,10"
                        Background="#27AE60"
                        Command="{Binding SaveCommand}"
                        Content="保存"
                        Cursor="Hand"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" 
                         Style="{StaticResource RoundedButtonStyle}"/>
                    <Button
                        Width="80"
                        Background="red"
                        Command="{Binding DeleteCommand}"
                        Content="删除"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" 
                         Style="{StaticResource RoundedButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>