<!-- Views/NoteManageView.xaml -->
<UserControl x:Class="NoteApp.Views.NoteManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:conv="clr-namespace:NoteApp.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="#ECF0F1"
              Height="650" Width="1200">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:BooleanToColorConverter x:Key="BooleanToColorConverter"/>
        <conv:BooleanToStarConverter x:Key="BooleanToStarConverter"/>

        <DataTemplate x:Key="NoteItemTemplate">
            <Border Background="{Binding Color, FallbackValue=White}"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5"
                    Cursor="Hand"
                    BorderBrush="#BDC3C7"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.08"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="{Binding Title}" 
                                   FontWeight="Bold" 
                                   FontSize="15"
                                   TextTrimming="CharacterEllipsis"/>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding IsFavorite, Converter={StaticResource BooleanToStarConverter}}" 
                                   FontSize="16"/>
                    </Grid>

                    <TextBlock Grid.Row="1" 
                               Text="{Binding Content}" 
                               FontSize="13"
                               Foreground="#7F8C8D"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="50"
                               Margin="0,5,0,0"/>

                    <TextBlock Grid.Row="2" 
                               Text="{Binding CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                               FontSize="11"
                               Foreground="#95A5A6"
                               Margin="0,5,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：便签列表 -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索栏 -->
                <Border Grid.Row="0" Background="White" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#F8F9FA"
                                 BorderBrush="#BDC3C7"
                                 FontSize="14"
                                 Height="35"
                                 Padding="35,0,10,0"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="🔍" 
                                   FontSize="18"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsHitTestVisible="False"/>
                        <TextBlock Text="搜索便签..." 
                                   FontSize="14"
                                   Foreground="#95A5A6"
                                   VerticalAlignment="Center"
                                   Margin="35,0,0,0"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- 工具栏 -->
                <Border Grid.Row="1" Background="White" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="➕ 新建" 
                                Command="{Binding AddCommand}"
                                Background="#27AE60"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="15,8"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#219A52"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <CheckBox Grid.Column="1" 
                                  Content="⭐ 只显示收藏" 
                                  IsChecked="{Binding ShowFavoritesOnly}"
                                  VerticalAlignment="Center"
                                  Margin="15,0,0,0"
                                  FontSize="13"
                                  Foreground="#2C3E50"/>

                        <Button Grid.Column="2" 
                                Content="🔄 刷新" 
                                Command="{Binding RefreshCommand}"
                                Background="#3498DB"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="15,8"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" 
                                                                      VerticalAlignment="Center"
                                                                      Margin="{TemplateBinding Padding}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#2980B9"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- 便签列表 -->
                <ListBox Grid.Row="2" 
                         ItemsSource="{Binding Notes}"
                         SelectedItem="{Binding SelectedNote}"
                         ItemTemplate="{StaticResource NoteItemTemplate}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="#3498DB"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- 右侧：便签详情 -->
        <Border Grid.Column="1" Background="White" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 如果未选中便签 -->
                <StackPanel Grid.Row="0" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibilityConverter}}">
                    <TextBlock Text="📝" FontSize="64" HorizontalAlignment="Center"/>
                    <TextBlock Text="请选择一条便签" 
                               FontSize="18" 
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="或点击左侧的「新建」创建新便签" 
                               FontSize="13" 
                               Foreground="#BDC3C7"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- 便签编辑区域 -->
                <Grid Grid.Row="0" 
                      Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" 
                                     Text="{Binding EditingNote.Title, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="22"
                                     FontWeight="Bold"
                                     BorderThickness="0"
                                     IsReadOnly="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                                     Background="Transparent"
                                     Padding="5">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Style.Triggers>
                                            <Trigger Property="IsReadOnly" Value="True">
                                                <Setter Property="BorderBrush" Value="Transparent"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="Cursor" Value="Arrow"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>

                            <Button Grid.Column="1" 
                                    Content="{Binding SelectedNote.IsFavorite, Converter={StaticResource BooleanToStarConverter}}" 
                                    Command="{Binding ToggleFavoriteCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="28"
                                    Cursor="Hand"
                                    Padding="10"/>
                        </Grid>
                    </StackPanel>

                    <!-- 信息 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="创建： " Foreground="#95A5A6" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNote.CreateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                   Foreground="#95A5A6" 
                                   FontSize="12"/>
                        <TextBlock Text=" | " Foreground="#BDC3C7" FontSize="12" Margin="10,0"/>
                        <TextBlock Text="更新： " Foreground="#95A5A6" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedNote.UpdateTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" 
                                   Foreground="#95A5A6" 
                                   FontSize="12"
                                   Visibility="{Binding SelectedNote.UpdateTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <TextBlock Text="未更新" 
                                   Foreground="#95A5A6" 
                                   FontSize="12"
                                   Visibility="{Binding SelectedNote.UpdateTime, Converter={StaticResource NullToVisibilityConverter}}"/>
                    </StackPanel>

                    <!-- 内容 -->
                    <TextBox Grid.Row="2" 
                             Text="{Binding EditingNote.Content, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                             Background="Transparent"
                             BorderThickness="0"
                             FontSize="15"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Padding="5">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="IsReadOnly" Value="True">
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <!-- 按钮 -->
                <StackPanel Grid.Row="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0"
                            Visibility="{Binding SelectedNote, Converter={StaticResource NullToVisibilityConverter}}">
                    <Button Content="✏️ 编辑" 
                            Command="{Binding EditCommand}"
                            Background="#3498DB"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            Margin="5,0"
                            Cursor="Hand"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2980B9"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="💾 保存" 
                            Command="{Binding SaveCommand}"
                            Background="#27AE60"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            Margin="5,0"
                            Cursor="Hand"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#219A52"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="❌ 取消" 
                            Command="{Binding CancelCommand}"
                            Background="#95A5A6"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            Margin="5,0"
                            Cursor="Hand"
                            Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7F8C8D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="🗑️ 删除" 
                            Command="{Binding DeleteCommand}"
                            Background="#E74C3C"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="20,10"
                            Margin="5,0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center"
                                                                  Margin="{TemplateBinding Padding}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>