<!--  Views/RegisterView.xaml  -->
<Window
    x:Class="NoteApp.Views.RegisterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:NoteApp.Converters"
    xmlns:prism="http://prismlibrary.com/"
    Title="注册新账户"
    Width="520"
    Height="750"
    prism:ViewModelLocator.AutoWireViewModel="True"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="#2C3E50">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <Border
            Grid.Row="0"
            Padding="20"
            Background="#34495E">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="📝 注册新账户" />
                <TextBlock
                    Margin="0,5,0,0"
                    HorizontalAlignment="Center"
                    FontSize="13"
                    Foreground="#BDC3C7"
                    Text="创建您的便签管理账户" />
            </StackPanel>
        </Border>

        <!--  注册表单  -->
        <ScrollViewer
            Grid.Row="1"
            Background="Transparent"
            VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,10,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  用户名  -->
                <StackPanel Grid.Row="0" Margin="0,10">
                    <Label
                        Content="👤 用户名 *"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <TextBox
                        Height="35"
                        Padding="10"
                        Background="#34495E"
                        BorderBrush="#5D6D7E"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                        Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Margin="5,2,0,0"
                        FontSize="11"
                        Foreground="#7F8C8D"
                        Text="至少3个字符" />
                </StackPanel>

                <!--  密码  -->
                <StackPanel Grid.Row="1" Margin="0,10">
                    <Label
                        Content="🔒 密码 *"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <PasswordBox
                        x:Name="PasswordBox"
                        Height="35"
                        Padding="10"
                        Background="#34495E"
                        BorderBrush="#5D6D7E"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                        KeyDown="PasswordBox_KeyDown"
                        PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBlock
                        Margin="5,2,0,0"
                        FontSize="11"
                        Foreground="#7F8C8D"
                        Text="至少6个字符" />
                </StackPanel>

                <!--  确认密码  -->
                <StackPanel Grid.Row="2" Margin="0,10">
                    <Label
                        Content="✅ 确认密码 *"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <PasswordBox
                        x:Name="ConfirmPasswordBox"
                        Height="35"
                        Padding="10"
                        Background="#34495E"
                        BorderBrush="#5D6D7E"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                        KeyDown="PasswordBox_KeyDown"
                        PasswordChanged="ConfirmPasswordBox_PasswordChanged" />
                </StackPanel>

                <!--  电话  -->
                <StackPanel Grid.Row="3" Margin="0,10">
                    <Label
                        Content="📱 电话"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <TextBox
                        Height="35"
                        Padding="10"
                        Background="#34495E"
                        BorderBrush="#5D6D7E"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                        Text="{Binding Phone}" />
                </StackPanel>

                <!--  地址  -->
                <StackPanel Grid.Row="4" Margin="0,10">
                    <Label
                        Content="📍 地址"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="White" />
                    <TextBox
                        Height="35"
                        Padding="10"
                        Background="#34495E"
                        BorderBrush="#5D6D7E"
                        FontSize="14"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}"
                        Text="{Binding Address}" />
                </StackPanel>

                <!--  错误信息  -->
                <TextBlock
                    Grid.Row="5"
                    Margin="0,10,0,0"
                    FontSize="13"
                    Foreground="#E74C3C"
                    Text="{Binding ErrorMessage}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}" />

                <!--  按钮  -->
                <StackPanel
                    Grid.Row="6"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Width="130"
                        Height="45"
                        Margin="5"
                        Background="#27AE60"
                        Command="{Binding RegisterCommand}"
                        Content="注册"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#219A52" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#1B7A41" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button
                        Width="130"
                        Height="45"
                        Margin="5"
                        Background="#E74C3C"
                        Command="{Binding CancelCommand}"
                        Content="取消"
                        Cursor="Hand"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="White">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#A93226" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!--  加载中  -->
                <StackPanel
                    Grid.Row="7"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar
                        Width="200"
                        Height="5"
                        Foreground="#3498DB"
                        IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,5,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="#BDC3C7"
                        Text="正在注册..." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--  底部  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="#34495E">
            <TextBlock
                HorizontalAlignment="Center"
                Cursor="Hand"
                FontSize="13"
                Foreground="#3498DB"
                MouseDown="LoginText_MouseDown"
                Text="已有账号？返回登录" />
        </Border>
    </Grid>
</Window>