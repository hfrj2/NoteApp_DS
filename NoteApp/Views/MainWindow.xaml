<!-- Views/MainWindow.xaml -->
<Window x:Class="NoteApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:conv="clr-namespace:NoteApp.Converters"
        prism:ViewModelLocator.AutoWireViewModel="True"
        Title="便签管理系统" 
        Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        MinHeight="600" MinWidth="900">

    <Window.Resources>
        <conv:RoleToVisibilityConverter x:Key="RoleToVisibilityConverter"/>
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0" 
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3D566E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A252F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📝 便签管理" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,20,0"/>
                    <TextBlock Text="欢迎，" Foreground="#BDC3C7" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="{Binding CurrentUsername}" 
                               Foreground="#3498DB" 
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               FontSize="14"/>
                    <TextBlock Text=" (" Foreground="#BDC3C7" VerticalAlignment="Center" FontSize="14"/>
                    <TextBlock Text="{Binding CurrentRole}" 
                               Foreground="#F39C12" 
                               VerticalAlignment="Center"
                               FontSize="14"/>
                    <TextBlock Text=")" Foreground="#BDC3C7" VerticalAlignment="Center" FontSize="14"/>
                </StackPanel>

                <!-- 中间菜单 -->
                <StackPanel Grid.Column="1" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Button Content="📋 我的便签" 
                            Command="{Binding NavigateToNotesCommand}"
                            Style="{StaticResource MenuButtonStyle}"/>

                    <Button Content="👤 用户管理" 
                            Command="{Binding NavigateToUsersCommand}"
                            Style="{StaticResource MenuButtonStyle}"
                            Visibility="{Binding CurrentRole, Converter={StaticResource RoleToVisibilityConverter}}"/>
                </StackPanel>

                <!-- 右侧按钮 -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center">
                    <Button Content="🚪 退出登录" 
                            Command="{Binding LogoutCommand}"
                            
                            Background="#E74C3C"
                            Margin="5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C0392B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="✖" 
                            Command="{Binding ExitCommand}"
                            Background="Transparent"
                            Foreground="#E74C3C"
                            FontSize="20"
                            Width="35"
                            Height="35"
                            Margin="5,0,0,0"
                            Cursor="Hand"
                            BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主内容区域 -->
        <Grid Grid.Row="1">
            <ContentControl prism:RegionManager.RegionName="ContentRegion"
                            Background="#ECF0F1"/>
        </Grid>
    </Grid>
</Window>